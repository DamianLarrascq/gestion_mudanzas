From cbf4cba8b81061ee54704ac90f8e18d560372ddf Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Mon, 22 Jun 2026 01:59:27 +0000
Subject: [PATCH] =?UTF-8?q?feat(empleados):=20vista=20detalle,=20edici?=
 =?UTF-8?q?=C3=B3n=20y=20borrado?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- urls.py: agrega empleado_detail, empleado_update, empleado_delete
- views.py: EmpleadoDetailView (GET), EmpleadoUpdateView (GET+POST con
  validación de unicidad dni/nro_licencia), empleado_delete (solo POST,
  elimina Empleado y su User asociado con messages.success)
- templates/gestion/empleados/detalle.html: template dual (lectura /
  edición según modo_edicion en contexto). Incluye:
    · Sección datos personales, disponibilidad/seguros, licencia
    · Toggle switches para disponible y art
    · Modal de confirmación antes de borrar (POST form, cierra con
      Escape o click fuera del overlay)
    · Botones editar/cancelar/guardar con validación de vuelta al
      detalle via messages
- empleados_service.py: url_detalle usa reverse() en vez de string
  hardcodeado; agrega import de django.urls.reverse
---
 gestion/services/empleados_service.py         |   3 +-
 .../templates/gestion/empleados/detalle.html  | 560 ++++++++++++++++++
 gestion/urls.py                               |   3 +
 gestion/views.py                              | 132 +++++
 4 files changed, 697 insertions(+), 1 deletion(-)
 create mode 100644 gestion/templates/gestion/empleados/detalle.html

diff --git a/gestion/services/empleados_service.py b/gestion/services/empleados_service.py
index d1051b5..b49e363 100644
--- a/gestion/services/empleados_service.py
+++ b/gestion/services/empleados_service.py
@@ -3,6 +3,7 @@ from dataclasses import dataclass
 from datetime import date, timedelta
 from typing import Optional
 from django.db.models import Count, Q, QuerySet
+from django.urls import reverse
 from django.utils import timezone
 from gestion.models.flota import Empleado
 from gestion.models.mudanzas import Mudanza
@@ -161,7 +162,7 @@ def _serializar_empleado(emp: Empleado, hoy: date) -> dict:
         # Flag consolidado para ícono de alerta en la fila
         "tiene_alerta_documental": tiene_alerta_documental,
         # URL detalle
-        "url_detalle": f"/gestion/empleados/{emp.pk}/",
+        "url_detalle": reverse("gestion:empleado_detail", kwargs={"pk": emp.pk}),
     }
 
 # Queryset base
diff --git a/gestion/templates/gestion/empleados/detalle.html b/gestion/templates/gestion/empleados/detalle.html
