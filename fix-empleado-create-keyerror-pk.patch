El str_replace previo omitió la línea 'class EmpleadoDetailView(...)' y
pegó su docstring + template_name + get_context_data como cuerpo extra
de EmpleadoCreateView. Python pisaba template_name='nuevo.html' con
'detalle.html' y get_context_data (sin pk) con la que hace
self.kwargs['pk'], causando KeyError en GET /empleados/nuevo/.
---
 gestion/views.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gestion/views.py b/gestion/views.py
index 5e3b91d..4333052 100644
--- a/gestion/views.py
+++ b/gestion/views.py
@@ -320,6 +320,9 @@ class EmpleadoCreateView(StaffRequiredMixin, TemplateView):
             f"Asigná una contraseña desde el panel de administración."
         )
         return redirect("gestion:empleado_detail", pk=empleado.pk)
+
+
+class EmpleadoDetailView(StaffRequiredMixin, TemplateView):
     """
     GET /gestion/empleados/<pk>/
 
