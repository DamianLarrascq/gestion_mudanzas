+  .breadcrumb svg { width: 11px; height: 11px; stroke: var(--text-secondary); fill: none; stroke-width: 2.5; }
+
+  /* ── Header ─────────────────────────────────────── */
+  .page-header { margin-bottom: 28px; }
+  .page-header h1 {
+    font-family: var(--font-title);
+    font-size: 2rem;
+    font-weight: 400;
+    margin: 0 0 6px;
+  }
+  .page-header p {
+    font-size: 0.88rem;
+    color: var(--text-secondary);
+    margin: 0;
+  }
+
+  /* ── Card ───────────────────────────────────────── */
+  .card {
+    background: var(--surface);
+    border: 1px solid var(--border);
+    border-radius: var(--radius);
+    margin-bottom: 18px;
