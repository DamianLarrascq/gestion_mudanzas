@@ -0,0 +1,378 @@
+{% extends "admin/base_admin.html" %}
+{% load static %}
+
+{% block title %}{{ titulo_pagina }}{% endblock %}
+
+{% block content %}
+<style>
+  :root { --radius: 13px; --radius-sm: 8px; }
+
+  .detalle-page {
+    margin: 0 auto;
+    padding: 32px 36px 56px;
+    max-width: 960px;
+    font-family: var(--font-body, 'Inter', sans-serif);
+    color: var(--text-primary);
+  }
+
+  /* ── Breadcrumb ─────────────────────────────────── */
+  .breadcrumb {
+    display: flex; align-items: center; gap: 8px;
+    font-size: .85rem; color: var(--text-secondary); margin-bottom: 24px;
+  }
+  .breadcrumb a { color: var(--accent-hover); text-decoration: none; }
+  .breadcrumb a:hover { text-decoration: underline; }
+  .breadcrumb svg { width: 11px; height: 11px; stroke: var(--text-secondary); fill: none; stroke-width: 2.5; }
+
+  /* ── Header ─────────────────────────────────────── */
+  .emp-header {
+    display: flex; align-items: flex-start; justify-content: space-between;
+    gap: 16px; flex-wrap: wrap; margin-bottom: 28px;
+  }
+  .emp-header-left h1 {
+    font-size: 2rem; font-weight: 700; margin: 0 0 6px; color: var(--text-primary);
+    font-family: var(--font-title, 'DM Serif Display', serif);
+  }
+  .cat-pill {
+    display: inline-flex; align-items: center; gap: 5px;
+    padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700;
+    letter-spacing: .06em; text-transform: uppercase;
+    background: rgba(79,124,255,.13); color: var(--accent); border: 1px solid rgba(79,124,255,.25);
+  }
+  .header-actions { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
+
+  /* ── Botones ────────────────────────────────────── */
+  .btn {
+    display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px;
+    border-radius: var(--radius-sm); font-size: .88rem; font-weight: 600;
+    font-family: inherit; cursor: pointer; border: 1px solid transparent;
+    text-decoration: none; transition: background .15s, border-color .15s, transform .1s; white-space: nowrap;
+  }
+  .btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.2; }
+  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
+  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); }
+  .btn-ghost   { background: transparent; color: var(--text-secondary); border-color: var(--border); }
+  .btn-ghost:hover { color: var(--text-primary); border-color: rgba(255,255,255,.2); }
+  .btn-danger  { background: rgba(239,68,68,.1); color: var(--danger); border-color: rgba(239,68,68,.3); }
+  .btn-danger:hover  { background: rgba(239,68,68,.2); transform: translateY(-1px); }
+  .btn-success { background: rgba(34,197,94,.12); color: var(--success); border-color: rgba(34,197,94,.3); }
+  .btn-success:hover { background: rgba(34,197,94,.22); transform: translateY(-1px); }
+
+  /* ── Cards ──────────────────────────────────────── */
+  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 18px; animation: fadeUp .35s ease both; }
+  .card-header { padding: 16px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
+  .card-header h2 { font-size: .82rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-secondary); margin: 0; }
+  .card-body { padding: 22px; }
+
+  /* ── Campos ─────────────────────────────────────── */
+  .field-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px 28px; }
+  .field-grid.three { grid-template-columns: repeat(3,1fr); }
+  @media(max-width:640px) { .field-grid, .field-grid.three { grid-template-columns: 1fr; } }
+  .field-block { display: flex; flex-direction: column; gap: 5px; }
+  .field-block label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-secondary); }
+  .field-value { font-size: .95rem; color: var(--text-primary); font-weight: 500; }
+  .field-value.muted { color: var(--text-secondary); font-style: italic; font-weight: 400; }
+
+  /* ── Inputs ─────────────────────────────────────── */
+  .field-input, .field-select {
+    width: 100%; background: var(--bg-elevated); border: 1px solid var(--border);
+    border-radius: var(--radius-sm); color: var(--text-primary); font-size: .93rem;
+    font-family: inherit; padding: 9px 13px; outline: none; box-sizing: border-box;
+    transition: border-color .15s, box-shadow .15s;
+  }
+  .field-input:focus, .field-select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(79,124,255,.15); }
+  .field-select option { background: #1a1d2a; }
+
+  /* ── Toggles ────────────────────────────────────── */
+  .toggle-group { display: flex; align-items: center; gap: 10px; padding: 6px 0; }
+  .toggle-group input[type="checkbox"] {
+    appearance: none; width: 38px; height: 22px; border-radius: 11px;
+    background: var(--border); cursor: pointer; position: relative; transition: background .2s; flex-shrink: 0;
+  }
+  .toggle-group input[type="checkbox"]::after {
+    content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px;
+    border-radius: 50%; background: #fff; transition: left .2s;
+  }
+  .toggle-group input[type="checkbox"]:checked { background: var(--success); }
+  .toggle-group input[type="checkbox"]:checked::after { left: 19px; }
+  .toggle-label { font-size: .90rem; color: var(--text-primary); font-weight: 500; }
+
+  /* ── Badges ─────────────────────────────────────── */
+  .badge-ok      { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700;background:rgba(34,197,94,.12);color:var(--success);border:1px solid rgba(34,197,94,.25); }
+  .badge-danger  { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700;background:rgba(239,68,68,.12);color:var(--danger);border:1px solid rgba(239,68,68,.25); }
+  .badge-warn    { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700;background:rgba(245,158,11,.12);color:var(--warning,#f59e0b);border:1px solid rgba(245,158,11,.25); }
+  .badge-neutral { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700;background:rgba(148,163,184,.1);color:var(--text-secondary);border:1px solid var(--border); }
+
+  /* ── Errores ────────────────────────────────────── */
+  .error-list { background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);border-left:3px solid var(--danger);border-radius:var(--radius-sm);padding:12px 16px;margin-bottom:20px; }
+  .error-list p { margin:0 0 4px;font-size:.88rem;color:var(--danger); }
+  .error-list p:last-child { margin:0; }
+
+  /* ── Modal borrado ──────────────────────────────── */
+  .modal-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9000;align-items:center;justify-content:center; }
+  .modal-overlay.open { display:flex; }
+  .modal-box { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px 28px;max-width:420px;width:90%;animation:fadeUp .2s ease both; }
+  .modal-icon { width:48px;height:48px;border-radius:50%;background:rgba(239,68,68,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 16px; }
+  .modal-icon svg { width:24px;height:24px;stroke:var(--danger);fill:none;stroke-width:2; }
+  .modal-box h3 { font-size:1.3rem;font-weight:700;text-align:center;margin:0 0 8px; }
+  .modal-box p  { font-size:.88rem;color:var(--text-secondary);text-align:center;margin:0 0 24px;line-height:1.5; }
+  .modal-actions { display:flex;gap:10px; }
+  .modal-actions .btn { flex:1;justify-content:center; }
+
+  @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
+</style>
+
+{# ── Modal confirmación borrado ───────────────────────────── #}
+<div class="modal-overlay" id="modal-borrar">
+  <div class="modal-box">
+    <div class="modal-icon">
+      <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
+    </div>
+    <h3>¿Eliminar vehículo?</h3>
+    <p>
+      Se eliminará el vehículo <strong>{{ camion.patente }} — {{ camion.modelo }}</strong>.<br>
+      Esta acción no se puede deshacer.
+    </p>
+    <div class="modal-actions">
+      <button class="btn btn-ghost" onclick="cerrarModal()">Cancelar</button>
+      <form method="post" action="{% url 'gestion:camion_delete' camion.pk %}" style="flex:1;display:flex;">
+        {% csrf_token %}
+        <button type="submit" class="btn btn-danger" style="flex:1;justify-content:center;">
+          <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
+          Sí, eliminar
+        </button>
+      </form>
+    </div>
+  </div>
+</div>
+
+<div class="detalle-page">
+
+  {# ── Breadcrumb ──────────────────────────────────────────── #}
+  <nav class="breadcrumb">
+    <a href="{% url 'gestion:flota_monitor' %}">Flota</a>
+    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
+    <span>{{ camion.patente }}</span>
+    {% if modo_edicion %}
+      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
+      <span>Editar</span>
+    {% endif %}
+  </nav>
+
+  {# ── Header ──────────────────────────────────────────────── #}
+  <div class="emp-header">
+    <div class="emp-header-left">
+      <h1>{{ camion.patente }}</h1>
+      <span class="cat-pill">{{ camion.get_categoria_display }}</span>
+    </div>
+    <div class="header-actions">
+      {% if modo_edicion %}
+        <a href="{% url 'gestion:camion_detail' camion.pk %}" class="btn btn-ghost">
+          <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
+          Cancelar
+        </a>
+      {% else %}
+        <button class="btn btn-danger" onclick="abrirModal()">
+          <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
+          Eliminar
+        </button>
+        <a href="{% url 'gestion:camion_update' camion.pk %}" class="btn btn-primary">
+          <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
+          Editar
+        </a>
+      {% endif %}
+    </div>
+  </div>
+
+  {# ── Errores ─────────────────────────────────────────────── #}
+  {% if errors %}
+  <div class="error-list">{% for e in errors %}<p>{{ e }}</p>{% endfor %}</div>
+  {% endif %}
+
+  {% if modo_edicion %}<form method="post" action="{% url 'gestion:camion_update' camion.pk %}">{% csrf_token %}{% endif %}
+
+    {# ── Datos del vehículo ───────────────────────── #}
+    <div class="card">
+      <div class="card-header">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
+        <h2>Datos del vehículo</h2>
+      </div>
+      <div class="card-body">
+        <div class="field-grid three">
+
+          <div class="field-block">
+            <label>Patente</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="text" name="patente" value="{{ camion.patente }}" required style="text-transform:uppercase;">
+            {% else %}
+              <div class="field-value">{{ camion.patente }}</div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Modelo</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="text" name="modelo" value="{{ camion.modelo }}" required>
+            {% else %}
+              <div class="field-value">{{ camion.modelo }}</div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Año</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="number" name="anio" value="{{ camion.anio }}" min="1900" max="2100" placeholder="Ej: 2020">
+            {% else %}
+              <div class="field-value {% if not camion.anio %}muted{% endif %}">{{ camion.anio|default:"Sin datos" }}</div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Categoría</label>
+            {% if modo_edicion %}
+              <select class="field-select" name="categoria">
+                {% for op in opciones_categoria %}
+                  <option value="{{ op.valor }}" {% if camion.categoria == op.valor %}selected{% endif %}>{{ op.label }}</option>
+                {% endfor %}
+              </select>
+            {% else %}
+              <div class="field-value">{{ camion.get_categoria_display }}</div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Volumen máx. (m³)</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="number" name="capacidad_volumen_m3" value="{{ camion.capacidad_volumen_m3 }}" step="0.01" min="0.01" required>
+            {% else %}
+              <div class="field-value">{{ camion.capacidad_volumen_m3 }} m³</div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Peso máx. (kg)</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="number" name="capacidad_peso_kg" value="{{ camion.capacidad_peso_kg }}" step="0.01" min="0.01" required>
+            {% else %}
+              <div class="field-value">{{ camion.capacidad_peso_kg }} kg</div>
+            {% endif %}
+          </div>
+
+        </div>
+      </div>
+    </div>
+
+    {# ── Estado operativo ─────────────────────────── #}
+    <div class="card">
+      <div class="card-header">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="20 4 12 12 9 9"/></svg>
+        <h2>Estado operativo</h2>
+      </div>
+      <div class="card-body">
+        <div class="field-grid">
+
+          <div class="field-block">
+            <label>Activo en flota</label>
+            {% if modo_edicion %}
+              <div class="toggle-group">
+                <input type="checkbox" name="activo" id="toggle-activo" value="1" {% if camion.activo %}checked{% endif %}>
+                <label class="toggle-label" for="toggle-activo">Disponible para mudanzas</label>
+              </div>
+            {% else %}
+              {% if camion.activo %}
+                <span class="badge-ok"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Activo</span>
+              {% else %}
+                <span class="badge-danger"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>Inactivo</span>
+              {% endif %}
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>En taller</label>
+            {% if modo_edicion %}
+              <div class="toggle-group">
+                <input type="checkbox" name="en_taller" id="toggle-taller" value="1" {% if camion.en_taller %}checked{% endif %}>
+                <label class="toggle-label" for="toggle-taller">Fuera de servicio por mantenimiento</label>
+              </div>
+            {% else %}
+              {% if camion.en_taller %}
+                <span class="badge-warn">⚙ En taller</span>
+              {% else %}
+                <span class="badge-neutral">No</span>
+              {% endif %}
+            {% endif %}
+          </div>
+
+        </div>
+      </div>
+    </div>
+
+    {# ── Documentación ────────────────────────────── #}
+    <div class="card">
+      <div class="card-header">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
+        <h2>Documentación (vencimientos)</h2>
+      </div>
+      <div class="card-body">
+        <div class="field-grid three">
+
+          <div class="field-block">
+            <label>VTV — vence</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="date" name="vtv_fecha_vencimiento" value="{{ camion.vtv_fecha_vencimiento|date:'Y-m-d'|default:'' }}">
+            {% else %}
+              <div class="field-value {% if not camion.vtv_fecha_vencimiento %}muted{% endif %}">
+                {{ camion.vtv_fecha_vencimiento|date:"d/m/Y"|default:"Sin datos" }}
+              </div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Seguro — vence</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="date" name="seguro_fecha_vencimiento" value="{{ camion.seguro_fecha_vencimiento|date:'Y-m-d'|default:'' }}">
+            {% else %}
+              <div class="field-value {% if not camion.seguro_fecha_vencimiento %}muted{% endif %}">
+                {{ camion.seguro_fecha_vencimiento|date:"d/m/Y"|default:"Sin datos" }}
+              </div>
+            {% endif %}
+          </div>
+
+          <div class="field-block">
+            <label>Patente — vence</label>
+            {% if modo_edicion %}
+              <input class="field-input" type="date" name="patente_fecha_vencimiento" value="{{ camion.patente_fecha_vencimiento|date:'Y-m-d'|default:'' }}">
+            {% else %}
+              <div class="field-value {% if not camion.patente_fecha_vencimiento %}muted{% endif %}">
+                {{ camion.patente_fecha_vencimiento|date:"d/m/Y"|default:"Sin datos" }}
+              </div>
+            {% endif %}
+          </div>
+
+        </div>
+      </div>
+    </div>
+
+    {% if modo_edicion %}
+    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:4px;">
+      <a href="{% url 'gestion:camion_detail' camion.pk %}" class="btn btn-ghost">Cancelar</a>
+      <button type="submit" class="btn btn-success">
+        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
+        Guardar cambios
+      </button>
+    </div>
+    {% endif %}
+
+  {% if modo_edicion %}</form>{% endif %}
+
+</div>
+
+<script>
+  function abrirModal()  { document.getElementById('modal-borrar').classList.add('open'); }
+  function cerrarModal() { document.getElementById('modal-borrar').classList.remove('open'); }
+  document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });
+  document.getElementById('modal-borrar').addEventListener('click', function(e) {
+    if (e.target === this) cerrarModal();
+  });
+</script>
+{% endblock %}
