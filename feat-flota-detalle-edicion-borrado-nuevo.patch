+            </select>
+          </div>
+
+          <div class="field-block">
+            <label>Volumen máx. (m³) <span class="required-star">*</span></label>
+            <input class="field-input" type="number" name="capacidad_volumen_m3"
+              value="{{ valores.capacidad_volumen_m3|default:'' }}" step="0.01" min="0.01"
+              placeholder="Ej: 20.00" required>
+          </div>
+
+          <div class="field-block">
+            <label>Peso máx. (kg) <span class="required-star">*</span></label>
+            <input class="field-input" type="number" name="capacidad_peso_kg"
+              value="{{ valores.capacidad_peso_kg|default:'' }}" step="0.01" min="0.01"
+              placeholder="Ej: 3500.00" required>
+          </div>
+
+        </div>
+      </div>
+    </div>
+
+    {# ── Estado operativo ─────────────────────────── #}
+    <div class="card">
+      <div class="card-header">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="20 4 12 12 9 9"/></svg>
+        <h2>Estado operativo</h2>
+      </div>
+      <div class="card-body">
+        <div class="field-grid">
+
+          <div class="field-block">
+            <label>Activo en flota</label>
+            <div class="toggle-group">
+              <input type="checkbox" name="activo" id="toggle-activo" value="1"
+                {% if not valores or valores.activo == '1' %}checked{% endif %}>
+              <label class="toggle-label" for="toggle-activo">Disponible para mudanzas al crearse</label>
+            </div>
+          </div>
+
+          <div class="field-block">
+            <label>En taller</label>
+            <div class="toggle-group">
+              <input type="checkbox" name="en_taller" id="toggle-taller" value="1"
+                {% if valores.en_taller == '1' %}checked{% endif %}>
+              <label class="toggle-label" for="toggle-taller">Fuera de servicio por mantenimiento</label>
+            </div>
+          </div>
+
+        </div>
+      </div>
+    </div>
+
+    {# ── Documentación ────────────────────────────── #}
+    <div class="card">
+      <div class="card-header">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
+        <h2>Documentación (vencimientos)</h2>
+      </div>
+      <div class="card-body">
+        <div class="field-grid three" style="margin-bottom:12px;">
+
+          <div class="field-block">
+            <label>VTV — vence</label>
+            <input class="field-input" type="date" name="vtv_fecha_vencimiento"
+              value="{{ valores.vtv_fecha_vencimiento|default:'' }}">
+          </div>
+
+          <div class="field-block">
+            <label>Seguro — vence</label>
+            <input class="field-input" type="date" name="seguro_fecha_vencimiento"
+              value="{{ valores.seguro_fecha_vencimiento|default:'' }}">
+          </div>
+
+          <div class="field-block">
+            <label>Patente — vence</label>
+            <input class="field-input" type="date" name="patente_fecha_vencimiento"
+              value="{{ valores.patente_fecha_vencimiento|default:'' }}">
+          </div>
