+  .page-header p  { font-size: .88rem; color: var(--text-secondary); margin: 0; }
+
+  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 18px; animation: fadeUp .35s ease both; }
+  .card-header { padding: 16px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
